<?xml version='1.0' encoding='utf-8'?>
<scheme version="2.0" title="W8 全班能力試驗：組間比較（ANOVA）" description="用箱形圖比較 5 組的盲樣結果；Box Plot 會自動做 ANOVA。Pivot Table 做成一般成分表。">
	<nodes>
		<node id="0" name="File" qualified_name="Orange.widgets.data.owfile.OWFile" project_name="Orange3" version="" title="File 讀入全班盲樣" position="(60, 280)" />
		<node id="1" name="Select Rows" qualified_name="Orange.widgets.data.owselectrows.OWSelectRows" project_name="Orange3" version="" title="Select Rows 選一個成分" position="(320, 180)" />
		<node id="2" name="Box Plot" qualified_name="Orange.widgets.visualize.owboxplot.OWBoxPlot" project_name="Orange3" version="" title="Box Plot 各組比較（ANOVA）" position="(580, 180)" />
		<node id="3" name="Pivot Table" qualified_name="Orange.widgets.data.owpivot.OWPivot" project_name="Orange3" version="" title="Pivot Table 一般成分表" position="(320, 420)" />
		<node id="4" name="Data Table" qualified_name="Orange.widgets.data.owtable.OWTable" project_name="Orange3" version="" title="Data Table" position="(580, 420)" />
	</nodes>
	<links>
		<link id="0" source_node_id="0" sink_node_id="1" source_channel="Data" sink_channel="Data" enabled="true" source_channel_id="data" sink_channel_id="data" />
		<link id="1" source_node_id="0" sink_node_id="3" source_channel="Data" sink_channel="Data" enabled="true" source_channel_id="data" sink_channel_id="data" />
		<link id="2" source_node_id="1" sink_node_id="2" source_channel="Matching Data" sink_channel="Data" enabled="true" source_channel_id="matching_data" sink_channel_id="data" />
		<link id="3" source_node_id="3" sink_node_id="4" source_channel="Pivot Table" sink_channel="Data" enabled="true" source_channel_id="pivot_table" sink_channel_id="data" />
	</links>
	<annotations>
		<text id="0" type="text/plain" rect="(20.0, 20.0, 260.0, 150.0)" font-family="Microsoft JhengHei" font-size="13">① File 讀入 W8 全班的盲樣數據（長格式：group、item、value）。
換成本班數據：在 File 選你們的 CSV。</text>
		<text id="1" type="text/plain" rect="(540.0, 10.0, 360.0, 130.0)" font-family="Microsoft JhengHei" font-size="13">② Select Rows 選一個成分（預設 ash 灰分，可改成 moisture、fat；protein 每組只有 1 管，不能做 ANOVA）。
③ Box Plot 依 group 分組：圖下方會顯示 ANOVA 的 F 與 p。p &lt; 0.05 表示至少有一組和別組不同。</text>
		<text id="2" type="text/plain" rect="(20.0, 520.0, 420.0, 100.0)" font-family="Microsoft JhengHei" font-size="13">④ Pivot Table：列＝組別、欄＝成分、值＝平均與 SD，就是一般成分表。
Grubbs、z-score、管制圖與不確定度請用 Excel EX08 或 Colab NB08。</text>
	</annotations>
	<thumbnail />
