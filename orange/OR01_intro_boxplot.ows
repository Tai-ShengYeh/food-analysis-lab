<?xml version='1.0' encoding='utf-8'?>
<scheme version="2.0" title="W1 Orange 入門：看分布、找異常值" description="第一次用 Orange：讀檔、看表格、依學生畫箱形圖，找出疑似記錄錯誤的數據。">
	<nodes>
		<node id="0" name="File" qualified_name="Orange.widgets.data.owfile.OWFile" project_name="Orange3" version="" title="File 讀入秤重數據" position="(60, 300)" />
		<node id="1" name="Data Table" qualified_name="Orange.widgets.data.owtable.OWTable" project_name="Orange3" version="" title="Data Table 看原始數據" position="(320, 120)" />
		<node id="2" name="Column Statistics" qualified_name="Orange.widgets.data.owfeaturestatistics.OWFeatureStatistics" project_name="Orange3" version="" title="Feature Statistics 描述統計" position="(320, 480)" />
		<node id="3" name="Select Rows" qualified_name="Orange.widgets.data.owselectrows.OWSelectRows" project_name="Orange3" version="" title="Select Rows 只看移液管" position="(320, 300)" />
		<node id="4" name="Box Plot" qualified_name="Orange.widgets.visualize.owboxplot.OWBoxPlot" project_name="Orange3" version="" title="Box Plot 各學生的分布" position="(580, 240)" />
		<node id="5" name="Distributions" qualified_name="Orange.widgets.visualize.owdistributions.OWDistributions" project_name="Orange3" version="" title="Distributions 直方圖" position="(580, 440)" />
		<node id="6" name="Data Table" qualified_name="Orange.widgets.data.owtable.OWTable" project_name="Orange3" version="" title="Data Table 被選取的點" position="(840, 240)" />
	</nodes>
	<links>
		<link id="0" source_node_id="0" sink_node_id="1" source_channel="Data" sink_channel="Data" enabled="true" source_channel_id="data" sink_channel_id="data" />
		<link id="1" source_node_id="0" sink_node_id="2" source_channel="Data" sink_channel="Data" enabled="true" source_channel_id="data" sink_channel_id="data" />
		<link id="2" source_node_id="0" sink_node_id="3" source_channel="Data" sink_channel="Data" enabled="true" source_channel_id="data" sink_channel_id="data" />
		<link id="3" source_node_id="3" sink_node_id="4" source_channel="Matching Data" sink_channel="Data" enabled="true" source_channel_id="matching_data" sink_channel_id="data" />
		<link id="4" source_node_id="3" sink_node_id="5" source_channel="Matching Data" sink_channel="Data" enabled="true" source_channel_id="matching_data" sink_channel_id="data" />
		<link id="5" source_node_id="4" sink_node_id="6" source_channel="Selected Data" sink_channel="Data" enabled="true" source_channel_id="selected_data" sink_channel_id="data" />
	</links>
	<annotations>
		<text id="0" type="text/plain" rect="(20.0, 20.0, 260.0, 170.0)" font-family="Microsoft JhengHei" font-size="13">① 雙擊 File：確認讀到 300 列（15 位同學 × 2 種器具 × 10 次）。
換成本班數據：在 File 按資料夾圖示，選你們的 CSV。

② 雙擊 Data Table 看原始表格。</text>
		<text id="1" type="text/plain" rect="(560.0, 30.0, 340.0, 150.0)" font-family="Microsoft JhengHei" font-size="13">③ Box Plot：每位同學一個箱形圖。
哪一位的箱子特別長、或有一個點離很遠？
在圖上框選那個點，右邊 Data Table 就會列出它，看 note 欄寫了什麼。</text>
		<text id="2" type="text/plain" rect="(560.0, 540.0, 360.0, 110.0)" font-family="Microsoft JhengHei" font-size="13">④ Feature Statistics：平均、SD、最大最小一次看完。
注意這裡是「秤到的水重 g」，換算體積請用 Excel EX01 或 Colab NB01。</text>
	</annotations>
	<thumbnail />
