<?xml version='1.0' encoding='utf-8'?>
<scheme version="2.0" title="W13 PLS：醋酸定量" description="SNV → PLS（2 LV）；校正集以樣品分組交叉驗證得 RMSECV，獨立測試集得 RMSEP。">
	<nodes>
		<node id="0" name="File" qualified_name="Orange.widgets.data.owfile.OWFile" project_name="Orange3" version="" title="File 醋酸 NIR 光譜" position="(60, 300)" />
