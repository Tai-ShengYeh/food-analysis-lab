[
 {
  "scene": "s0",
  "start": 0.56,
  "end": 2.96,
  "text": "這支 10 毫升的定量吸管",
  "speech": 1.8
 },
 {
  "scene": "s0",
  "start": 2.96,
  "end": 7.819999999999999,
  "text": "吸到標線、再放出來，真的剛好是 10 毫升嗎？",
  "speech": 4.26
 },
 {
  "scene": "s1",
  "start": 8.68,
  "end": 13.299999999999999,
  "text": "玻璃有製造誤差，每個人的手法也不一樣",
  "speech": 3.54
 },
 {
  "scene": "s1",
  "start": 13.299999999999999,
  "end": 16.119999999999997,
  "text": "就算是最高等級的 Class A",
  "speech": 2.82
 },
 {
  "scene": "s1",
  "start": 16.119999999999997,
  "end": 20.44,
  "text": "也只保證在正負 0.02 毫升以內",
  "speech": 3.72
 },
 {
  "scene": "s2",
  "start": 21.360000000000003,
  "end": 24.42,
  "text": "體積用眼睛讀，很難讀得準",
  "speech": 2.46
 },
 {
  "scene": "s2",
  "start": 24.42,
  "end": 27.180000000000003,
  "text": "質量卻可以秤得很準",
  "speech": 1.74
 },
 {
  "scene": "s2",
  "start": 27.180000000000003,
  "end": 31.080000000000002,
  "text": "所以我們把水放進加蓋的秤重瓶",
  "speech": 3.18
 },
 {
  "scene": "s2",
  "start": 31.080000000000002,
  "end": 34.86000000000001,
  "text": "用分析天平秤到 0.1 毫克",
  "speech": 3.18
 },
 {
  "scene": "s3",
  "start": 35.720000000000006,
  "end": 38.480000000000004,
  "text": "接著把質量換回體積",
  "speech": 1.86
 },
 {
  "scene": "s3",
  "start": 38.480000000000004,
  "end": 40.760000000000005,
  "text": "水的密度會隨溫度改變",
  "speech": 2.04
 },
 {
  "scene": "s3",
  "start": 40.760000000000005,
  "end": 42.68000000000001,
  "text": "所以每次都要記下水溫",
  "speech": 1.92
 },
 {
  "scene": "s3",
  "start": 42.68000000000001,
  "end": 49.580000000000005,
  "text": "25 度時，1 毫升的水大約是 0.997 公克",
  "speech": 6.3
 },
 {
  "scene": "s4",
  "start": 50.440000000000005,
  "end": 54.1,
  "text": "還有一個小細節：天平是在空氣裡秤的",
  "speech": 3.18
 },
 {
  "scene": "s4",
  "start": 54.1,
  "end": 58.120000000000005,
  "text": "空氣會把水往上托，讀數會輕一點點",
  "speech": 3.48
 },
 {
  "scene": "s4",
  "start": 58.120000000000005,
  "end": 62.56,
  "text": "所以要再乘上浮力校正大約千分之一",
  "speech": 2.22
 },
 {
  "scene": "s5",
  "start": 63.42,
  "end": 67.2,
  "text": "把數字代進公式：這次放出來的水",
  "speech": 3.66
 },
 {
  "scene": "s5",
  "start": 67.2,
  "end": 71.88,
  "text": "比 10 毫升多了 0.01，還在允許的範圍內",
  "speech": 4.08
 },
 {
  "scene": "s6",
  "start": 72.74000000000001,
  "end": 75.08000000000001,
  "text": "不過，只做一次還不夠",
  "speech": 1.68
 },
 {
  "scene": "s6",
  "start": 75.08000000000001,
  "end": 77.96000000000001,
  "text": "每支吸管要重複 10 次",
  "speech": 1.8
 },
 {
  "scene": "s6",
  "start": 77.96000000000001,
  "end": 80.78,
  "text": "平均離標示有多遠，看的是準確度",
  "speech": 2.82
 },
 {
  "scene": "s6",
  "start": 80.78,
  "end": 85.28,
  "text": "10 次散得有多開，看的是精密度",
  "speech": 3.9
 },
 {
  "scene": "s7",
  "start": 86.20000000000002,
  "end": 91.60000000000001,
  "text": "如果 10 次都偏向同一邊，就是系統誤差，要找出原因來修正",
  "speech": 4.8
 },
 {
  "scene": "s7",
  "start": 92.20000000000002,
  "end": 95.68,
  "text": "如果忽高忽低，就是隨機誤差",
  "speech": 2.82
 },
 {
  "scene": "s7",
  "start": 95.68,
  "end": 98.56,
  "text": "要靠多做幾次來描述它",
  "speech": 2.28
 },
 {
  "scene": "s8",
  "start": 99.48000000000002,
  "end": 103.92,
  "text": "上課時，你會親手校正自己的吸管和滴定管",
  "speech": 3.84
 },
 {
  "scene": "s8",
  "start": 104.58000000000001,
  "end": 109.62,
  "text": "先猜猜看：你手上的那支準嗎？",
  "speech": 3.0
 }
]