[
 {
  "scene": "s0",
  "start": 0.56,
  "end": 3.38,
  "text": "兩杯飲料，pH 都是 3.5",
  "speech": 2.82
 },
 {
  "scene": "s0",
  "start": 3.38,
  "end": 7.04,
  "text": "喝起來卻一杯比較酸為什麼？",
  "speech": 1.8
 },
 {
  "scene": "s1",
  "start": 7.9,
  "end": 11.260000000000002,
  "text": "因為 pH 只看游離的氫離子",
  "speech": 2.52
 },
 {
  "scene": "s1",
  "start": 11.260000000000002,
  "end": 16.240000000000002,
  "text": "可滴定酸度，算的是所有能被鹼中和的酸",
  "speech": 4.14
 },
 {
  "scene": "s1",
  "start": 16.240000000000002,
  "end": 19.48,
  "text": "連還沒解離的弱酸也算進去",
  "speech": 2.64
 },
 {
  "scene": "s2",
  "start": 20.28,
  "end": 23.1,
  "text": "做法是用氫氧化鈉滴定",
  "speech": 2.04
 },
 {
  "scene": "s2",
  "start": 23.1,
  "end": 26.64,
  "text": "但氫氧化鈉會吸水、吸二氧化碳",
  "speech": 3.18
 },
 {
  "scene": "s2",
  "start": 26.64,
  "end": 31.56,
  "text": "濃度不準，所以先用秤得準的 KHP 標定它",
  "speech": 4.32
 },
 {
  "scene": "s3",
  "start": 32.42,
  "end": 35.0,
  "text": "剛開始滴定，pH 慢慢爬",
  "speech": 2.16
 },
 {
  "scene": "s3",
  "start": 35.0,
  "end": 39.019999999999996,
  "text": "中間有一段幾乎不動，這是緩衝區",
  "speech": 3.0
 },
 {
  "scene": "s3",
  "start": 39.019999999999996,
  "end": 42.978,
  "text": "加到一半的時候，pH 剛好等於 pKa",
  "speech": 3.358
 },
 {
  "scene": "s4",
  "start": 43.838,
  "end": 46.717999999999996,
  "text": "接著 pH 突然一路往上衝",
  "speech": 2.34
 },
 {
  "scene": "s4",
  "start": 46.717999999999996,
  "end": 50.077999999999996,
  "text": "這就是當量點：加進去的鹼",
  "speech": 3.06
 },
 {
  "scene": "s4",
  "start": 50.077999999999996,
  "end": 52.238,
  "text": "剛好中和所有的酸",
  "speech": 1.56
 },
 {
  "scene": "s4",
  "start": 53.318,
  "end": 58.478,
  "text": "酚酞在 pH 8.2 變粉紅幾乎就在這裡",
  "speech": 2.88
 },
 {
  "scene": "s5",
  "start": 59.338,
  "end": 63.418,
  "text": "但紅酒本身就是紅的，粉紅色看不出來",
  "speech": 3.12
 },
 {
  "scene": "s5",
  "start": 63.418,
  "end": 67.018,
  "text": "這時改用 pH 電極自動記錄",
  "speech": 2.64
 },
 {
  "scene": "s5",
  "start": 67.018,
  "end": 69.958,
  "text": "曲線最陡的地方，就是終點",
  "speech": 2.34
 },
 {
  "scene": "s6",
  "start": 70.818,
  "end": 75.01799999999999,
  "text": "知道用了多少毫升的鹼，就能算出百分之幾的酸",
  "speech": 3.6
 },
 {
  "scene": "s6",
  "start": 75.618,
  "end": 80.77199999999999,
  "text": "例如這瓶醋，算出來大約是 4.56%",
  "speech": 4.554
 },
 {
  "scene": "s7",
  "start": 81.632,
  "end": 84.932,
  "text": "最後比較手動和自動兩種方法",
  "speech": 2.76
 },
 {
  "scene": "s7",
  "start": 84.932,
  "end": 87.932,
  "text": "相關係數高，不代表兩法一致",
  "speech": 2.52
 },
 {
  "scene": "s7",
  "start": 87.932,
  "end": 90.69200000000001,
  "text": "要看兩者相差多少、穩不穩",
  "speech": 2.46
 },
 {
  "scene": "s7",
  "start": 90.69200000000001,
  "end": 93.092,
  "text": "這就是 Bland–Altman 圖",
  "speech": 1.8
 },
 {
  "scene": "s8",
  "start": 93.952,
  "end": 98.512,
  "text": "這週上課，手動和 PASCO 你都會親手做一次",
  "speech": 3.54
 },
 {
  "scene": "s8",
  "start": 98.512,
  "end": 101.99199999999999,
  "text": "先猜猜看：兩個終點會差多少？",
  "speech": 2.88
 }
]